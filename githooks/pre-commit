#!/bin/sh
set -eu

staged_py=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
[ -n "$staged_py" ] || exit 0

if ! command -v ruff >/dev/null 2>&1; then
  printf '%s\n' 'Install the dev tools with: pip install -e ".[dev]"'
  exit 1
fi

old_ifs=$IFS
IFS='
'
set -f
set -- $staged_py
IFS=$old_ifs
set +f

if ruff format --check -- "$@"; then
  exit 0
fi

printf '%s\n' 'Fix formatting with: ruff format'
exit 1
